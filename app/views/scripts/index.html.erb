<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl mx-auto">
    
    <!-- 헤더 -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4">✨ AI ShortsMaker</h1>
      <p class="text-lg text-gray-600">주제만 입력하면 10초 만에 터지는 숏폼 대본을 만들어 드립니다.</p>
    </div>

    <!-- 입력 폼 -->
    <div class="bg-white rounded-2xl shadow-xl p-8 mb-8">
      <%= form_with url: "/scripts/generate", method: :post, data: { turbo: false }, class: "space-y-6" do |form| %>
        <div>
          <%= form.label :topic, "어떤 숏폼을 만들고 싶으신가요?", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.text_field :topic, placeholder: "ex) 숏폼 주제", class: "w-full", required: true %>
        </div>

        <%= form.submit "대본 생성하기 🚀", class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-lg font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer transition-colors" %>
      <% end %>
    </div>

    <!-- 에러 메시지 -->
    <% if @error.present? %>
      <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-8 rounded-md">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-red-700 font-medium"><%= @error %></p>
          </div>
        </div>
      </div>
    <% end %>

    <!-- 결과 대본 -->
    <% if @script.present? %>
      <div class="bg-white rounded-2xl shadow-xl p-8 mb-12 border-t-4 border-indigo-500">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
          🎬 완성된 숏폼 대본
        </h2>
        <div class="prose prose-indigo max-w-none text-gray-700 bg-gray-50 p-6 rounded-lg whitespace-pre-wrap leading-relaxed"><%= @script %></div>
      </div>

      <!-- 수익화 영역 (제휴 & 후원) -->
      <div class="space-y-6">
        <!-- 쿠팡 파트너스 배너 (수익화 1) -->
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl p-6 border border-blue-100 flex flex-col items-center text-center shadow-sm hover:shadow-md transition-shadow">
          <span class="inline-flex items-center px-3 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 mb-3">
            추천 장비
          </span>
          <h3 class="text-lg font-bold text-gray-900 mb-2">유튜버 필수 가성비 마이크 🎙️</h3>
          <p class="text-sm text-gray-600 mb-4">대본을 완벽하게 살려줄 고음질 마이크를 할인가에 만나보세요.</p>
          <a href="<%= ENV['COUPANG_PARTNERS_LINK'] || '#' %>" target="_blank" class="text-blue-600 font-bold hover:text-blue-800 underline decoration-2 underline-offset-4">
            쿠팡에서 최저가 확인하기 &rarr;
          </a>
          <p class="text-xs text-gray-400 mt-3">이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.</p>
        </div>

        <!-- Buy Me A Coffee (수익화 2) -->
        <div class="bg-white rounded-xl p-6 border border-gray-200 flex flex-col items-center text-center shadow-sm">
          <h3 class="text-lg font-bold text-gray-900 mb-2">대본이 마음에 드셨나요? ☕</h3>
          <p class="text-sm text-gray-600 mb-4">개발자에게 커피 한 잔을 후원해 주시면 더 좋은 기능으로 보답하겠습니다!</p>
          <a href="<%= ENV['BUY_ME_A_COFFEE_LINK'] || '#' %>" target="_blank" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-full shadow-sm text-white bg-yellow-500 hover:bg-yellow-600">
            ☕ 커피 한 잔 사주기
          </a>
        </div>
      </div>
    <% end %>

  </div>
</div>
