<div class="min-h-screen px-5 py-16 sm:py-20">
  <div class="mx-auto w-full max-w-xl">

    <!-- 헤더 -->
    <header>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight">AI ShortsMaker</h1>
      <p class="mt-3 text-ink/70 leading-relaxed">
        주제 하나만 넣으면 후킹 · 본문 · 콜투액션을 갖춘 30초 숏폼 대본이 나옵니다.
      </p>
    </header>

    <!-- 입력 폼: 9:16 뷰파인더 프레임 -->
    <div class="mt-10 mx-auto w-full max-w-sm">
      <div class="rounded-[2rem] border border-line bg-card p-1.5">
        <div class="flex items-center justify-between px-4 py-2.5">
          <div class="flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-accent animate-rec-pulse"></span>
            <span class="text-xs font-bold text-accent tracking-wide">REC</span>
          </div>
          <span class="text-xs text-direction">9:16</span>
        </div>

        <div class="rounded-[1.6rem] bg-paper px-6 py-8">
          <%= form_with url: "/scripts/generate", method: :post, data: { turbo: false, controller: "script-form", action: "submit->script-form#submit" }, class: "space-y-5" do |form| %>
            <div>
              <%= form.label :topic, "어떤 숏폼을 만들고 싶으신가요?", class: "block text-sm font-semibold text-ink mb-2" %>
              <%= form.text_field :topic,
                    placeholder: "예) 자취생 냉장고 파먹기",
                    maxlength: ScriptsController::MAX_TOPIC_LENGTH,
                    required: true,
                    class: "w-full rounded-xl border border-line bg-card px-4 py-3 text-ink placeholder:text-ink/35 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition" %>
            </div>

            <%= form.submit "대본 생성하기",
                  data: { script_form_target: "submit" },
                  class: "w-full rounded-xl bg-accent px-5 py-3.5 text-base font-bold text-white shadow-[0_4px_0_var(--color-accent-dark)] transition-all cursor-pointer hover:bg-accent-dark active:translate-y-1 active:shadow-none disabled:cursor-not-allowed disabled:opacity-60 disabled:active:translate-y-0 disabled:active:shadow-[0_4px_0_var(--color-accent-dark)]" %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- 수익화 영역 (제휴 & 후원): 대본 생성 전에도 항상 노출 -->
    <% if ENV["COUPANG_PARTNERS_LINK"].present? || ENV["BUY_ME_A_COFFEE_LINK"].present? %>
      <div class="mt-8 space-y-3">
        <% if ENV["COUPANG_PARTNERS_LINK"].present? %>
          <div>
            <div class="flex items-center gap-4 rounded-2xl border border-line bg-card p-4 sm:p-5">
              <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-ink/5 text-ink">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="2" width="6" height="12" rx="3" />
                  <path d="M5 10a7 7 0 0 0 14 0" />
                  <line x1="12" y1="19" x2="12" y2="22" />
                  <line x1="8" y1="22" x2="16" y2="22" />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-bold text-ink">숏폼 목소리, 마이크 하나로 달라집니다</p>
                <p class="mt-0.5 text-xs text-ink/55">대본만큼 중요한 음질, 가성비 마이크 추천</p>
              </div>
              <a href="<%= ENV["COUPANG_PARTNERS_LINK"] %>" target="_blank" rel="noopener"
                 class="flex-shrink-0 rounded-lg bg-ink px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-ink/85">
                최저가 보기
              </a>
            </div>
            <p class="mt-1.5 px-1 text-[11px] text-direction">이 링크는 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.</p>
          </div>
        <% end %>

        <% if ENV["BUY_ME_A_COFFEE_LINK"].present? %>
          <div class="flex items-center gap-4 rounded-2xl border border-line bg-card p-4 sm:p-5">
            <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-coffee/10 text-coffee">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8Z" />
                <path d="M17 9h1.5a2.5 2.5 0 0 1 0 5H17" />
                <path d="M8 3c-.5.7-.5 1.3 0 2s.5 1.3 0 2" />
                <path d="M12 3c-.5.7-.5 1.3 0 2s.5 1.3 0 2" />
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-bold text-ink">이 도구가 도움이 됐다면</p>
              <p class="mt-0.5 text-xs text-ink/55">커피 한 잔으로 다음 업데이트를 응원해주세요</p>
            </div>
            <a href="<%= ENV["BUY_ME_A_COFFEE_LINK"] %>" target="_blank" rel="noopener"
               class="flex-shrink-0 rounded-lg bg-coffee px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-coffee/85">
              ☕ 후원하기
            </a>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- 에러 메시지 -->
    <% if @error.present? %>
      <div role="alert" class="mt-8 flex items-start gap-3 rounded-xl border border-accent/25 bg-accent/5 p-4">
        <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-accent" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
        </svg>
        <p data-testid="error-message" class="text-sm font-medium text-ink"><%= @error %></p>
      </div>
    <% end %>

    <!-- 결과 대본 프레임: 생성 전에도 항상 자리를 잡고 있어 한 페이지처럼 보이게 함 -->
    <div class="mt-10">
      <div class="flex items-center gap-2 mb-3">
        <span class="h-1.5 w-1.5 rounded-full <%= @script.present? ? "bg-accent" : "bg-line" %>"></span>
        <h2 class="text-sm font-bold tracking-tight text-ink">완성된 대본</h2>
      </div>

      <% if @script.present? %>
        <div class="rounded-2xl border border-line bg-card p-6 sm:p-8" data-controller="markdown">
          <div data-markdown-target="source" class="hidden"><%= @script %></div>
          <div data-markdown-target="output" class="markdown-body text-[15px]"></div>
        </div>
      <% else %>
        <div class="rounded-2xl border border-dashed border-line bg-card/50 px-6 py-14 text-center">
          <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-xl bg-ink/5 text-ink/25">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z" />
              <path d="M14 3v5h5" />
              <path d="M9 13h6" />
              <path d="M9 17h6" />
            </svg>
          </div>
          <p class="mt-4 text-sm text-ink/40">주제를 입력하고 생성하면 여기에 대본이 나타납니다</p>
        </div>
      <% end %>
    </div>

  </div>
</div>
